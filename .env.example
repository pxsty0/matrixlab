# ==============================================================================
# MATRIXLAB - FIREBASE BULUT BAĞLANTI AYARLARI
# ==============================================================================
# 1. https://console.firebase.google.com üzerinden bir proje oluşturun.
# 2. Authentication (Email/Password) ve Firestore Database etkinleştirin.
# 3. Proje Ayarları -> Genel -> Uygulamalarınız -> Web Uygulaması Ekle adımlarını takip edin.
# 4. Aşağıdaki değerleri projenizin firebaseConfig nesnesinden doldurun:
# ==============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

